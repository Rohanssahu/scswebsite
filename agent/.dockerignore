# NOTE: src/, knowledge/, tsconfig.json, package.json and package-lock.json are
# all required by the build and by the running worker — never exclude them.

# Tests (also excluded from tsc via tsconfig.json "exclude")
**/*.test.ts
**/*.spec.ts
__tests__/
tests/
evals/

# Node.js dependencies — reinstalled in the image with `npm ci`
node_modules
.npm
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs — recompiled in the image with `npm run build`
dist/
build/
*.tsbuildinfo

# Local environment files — secrets must never enter the image.
# LiveKit Cloud injects LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET
# and the provider keys at runtime.
.env
.env.*
.envrc
*.local
.DS_Store

# Logs, coverage & temp files
coverage/
.nyc_output/
logs/
*.log
*.gz
*.tgz
.tmp
.cache

# Docker artifacts
Dockerfile*
.dockerignore
docker-compose*.yml

# Git & editor files
.git
.gitignore
.idea
.vscode

# Project docs and misc
README.md
CONTRIBUTING.md
LICENSE

# Coding agent files
.claude/
.codex/
.cursor/
.windsurf/
.gemini/
.cline/
.clinerules
.clinerules/
.aider*
.cursorrules
.cursorignore
.cursorindexingignore
.clineignore
.codeiumignore
.geminiignore
.windsurfrules
CLAUDE.md
AGENTS.md
GEMINI.md
.github/copilot-instructions.md
.github/personal-instructions.md
.github/instructions/
