# -----------------------------------------------------------------------------
# Buddy voice agent worker — environment variables. PLACEHOLDERS ONLY.
# Copy to `.env` for local development; set the same values as LiveKit Cloud
# agent secrets for deployment. NEVER commit real values and NEVER put any of
# these in the frontend / VITE_* variables.
# -----------------------------------------------------------------------------

# --- LiveKit (worker connection; from your LiveKit Cloud project) -------------
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- LLM provider (reasoning) ---------------------------------------------------
# 'gemini' (default, implemented) or 'openai' (implemented, kept as a fallback
# option) — see src/providers/llm.ts. An unrecognized value fails loudly.
BUDDY_LLM_PROVIDER=gemini
GOOGLE_API_KEY=
BUDDY_GEMINI_MODEL=gemini-3.6-flash

# --- STT provider (speech-to-text) -----------------------------------------------
# 'openai' is the ONLY implemented option today (see src/providers/stt.ts for
# why Gemini STT is not a safe drop-in yet: it needs either a GCP service
# account or a full realtime-pipeline redesign). Also required if
# BUDDY_LLM_PROVIDER=openai above (falls back to the same key/model).
BUDDY_STT_PROVIDER=openai
OPENAI_API_KEY=
BUDDY_OPENAI_MODEL=gpt-4o-mini

# --- ElevenLabs TTS -------------------------------------------------------------
ELEVENLABS_API_KEY=
# A multilingual voice id from your ElevenLabs VoiceLab (supports en + hi):
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5

# --- Consultation voice pacing (optional; validated, safe defaults apply) -------
# Consultation meetings are ENGLISH ONLY and deliberately slow. Out-of-range or
# non-numeric values are IGNORED and the default constant in src/config.ts is
# used instead — these can never break the voice. Bounds in brackets.
BUDDY_VOICE_SPEED=0.88          # [0.7 .. 1.2]  ElevenLabs voice_settings.speed
BUDDY_VOICE_STABILITY=0.60      # [0 .. 1]      calm, low variance
BUDDY_VOICE_SIMILARITY=0.75     # [0 .. 1]      similarity_boost
BUDDY_VOICE_STYLE=0.15          # [0 .. 1]      low style exaggeration

# --- Consultation turn-taking (optional; ALL VALUES IN MILLISECONDS) -----------
BUDDY_VAD_MIN_SILENCE_MS=700          # [650 .. 800]   VAD silence before a turn may end
BUDDY_ENDPOINTING_MIN_DELAY_MS=1000   # [900 .. 1200]  never answer before this
BUDDY_ENDPOINTING_MAX_DELAY_MS=4500   # [4000 .. 5000] longest thinking pause honoured
BUDDY_SILENCE_REMINDER_MS=10000       # [4000 .. 60000] one gentle "no rush" nudge

# --- Supabase backend (server-to-server; NO Supabase keys needed) ---------------
# Full URL of the voice-lead Edge Function. (BUDDY_ prefix on purpose:
# SUPABASE_* names are reserved by Supabase tooling.)
BUDDY_VOICE_LEAD_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1/voice-lead
# Full URL of the consultation-agent Edge Function (AI consultation meetings).
BUDDY_CONSULTATION_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1/consultation-agent
# Shared secret — must equal the VOICE_AGENT_SECRET Supabase function secret
# (generate with: openssl rand -hex 32):
VOICE_AGENT_SECRET=

# --- Session / cost limits (optional; safe defaults apply) ----------------------
BUDDY_AGENT_NAME=buddy-it-manager
BUDDY_MAX_SESSION_SECONDS=900
BUDDY_IDLE_TIMEOUT_SECONDS=90
BUDDY_MAX_LLM_TURNS=80
BUDDY_MAX_TRANSCRIPT_CHARS=8000
BUDDY_PROVIDER_TIMEOUT_MS=15000
BUDDY_BACKEND_TIMEOUT_MS=10000
